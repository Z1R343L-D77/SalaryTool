<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  让 App 的 Documents 目录出现在「文件」App 里：
	  文件 → 我的 iPhone → SalaryTool

	  没有这两项，导出到 Documents 的文件只能在 App 内部看到，
	  用户插数据线或想用 iCloud 都拿不到 —— 这也是之前「导出无效、
	  找不到文件」的直接原因（另一边还写到 cache 目录，那个更糟，
	  系统会直接清掉）。
	-->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- 中文界面：不声明的话系统菜单（复制/粘贴）会跟随设备语言 -->
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<!-- 只做竖屏：计算器是单手输入，横屏价值不大 -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- 用系统的浅色/深色，不强制 -->
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
</dict>
</plist>
