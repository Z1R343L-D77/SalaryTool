{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SalaryTool",
  "version": "0.2.0",
  "identifier": "com.salarytool.ios",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "当月薪水到手计算器",
        "width": 390,
        "height": 844,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "计算当月工资到手金额",
    "longDescription": "按基本工资、各类补贴、五险一金与累计预扣预缴个税计算当月实发工资。",
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
